# AgriAI Decision Support System - Environment Configuration
# Copy this file to .env and update the values as needed

# Application Settings
PROJECT_NAME="AgriAI Decision Support System"
VERSION="1.0.0"
DEBUG=true
SECRET_KEY="your-super-secret-key-change-this-in-production"

# Server Configuration
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000

# Database Configuration
DATABASE_URL="sqlite:///./agriai.db"
# For PostgreSQL (uncomment and modify):
# POSTGRES_SERVER="localhost"
# POSTGRES_USER="agriai_user"
# POSTGRES_PASSWORD="agriai_password"
# POSTGRES_DB="agriai"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
CACHE_EXPIRE_SECONDS=3600

# External API Keys
OPENWEATHER_API_KEY="your-openweathermap-api-key-here"
BHUVAN_API_KEY="your-bhuvan-api-key-here"

# Machine Learning Models
MODEL_PATH="../ml-models"
CROP_MODEL_PATH="../ml-models/crop_recommendation.joblib"
YIELD_MODEL_PATH="../ml-models/yield_prediction.joblib"

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_PATH="./uploads"

# Security Settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM="HS256"

# CORS Settings
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000"
ALLOWED_HOSTS="*"

# Monitoring and Logging
LOG_LEVEL="INFO"
ENABLE_METRICS=true

# Production Settings (for deployment)
# SSL_CERT_PATH="/path/to/ssl/cert.pem"
# SSL_KEY_PATH="/path/to/ssl/key.pem"
# DOMAIN="agriai.example.com"

# Email Configuration (for notifications)
# SMTP_SERVER="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USERNAME="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# FROM_EMAIL="noreply@agriai.com"

# Cloud Storage (optional)
# AWS_ACCESS_KEY_ID="your-aws-access-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="agriai-data"

# Mobile App Configuration
MOBILE_APP_VERSION="1.0.0"
MOBILE_SUPPORTED_LANGUAGES="en,hi,te,ta,kn,ml,gu,mr,bn,pa"

# Feature Flags
ENABLE_SATELLITE_DATA=true
ENABLE_IOT_SENSORS=true
ENABLE_DISEASE_DETECTION=true
ENABLE_MARKET_DATA=true
ENABLE_OFFLINE_MODE=true

# Analytics and Telemetry
ENABLE_ANALYTICS=false
ANALYTICS_API_KEY=""

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30